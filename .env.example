# --- EcoRoute AI configuration ---
# Copy to .env and adjust. All variables are optional; defaults shown.

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Security: comma-separated API keys. If empty, auth is disabled (dev mode).
API_KEYS=dev-key-123

# Rate limit: max requests per minute per API key
RATE_LIMIT_PER_MINUTE=60

# Inference provider: "heuristic" (default) or "kompact" (Phase 2 stub)
INFERENCE_PROVIDER=heuristic

# RAG
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=3
# Path to prebuilt FAISS index (built via: python scripts/build_index.py)
INDEX_PATH=data/index.faiss
CHUNKS_PATH=data/chunks.json

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Cost comparison baseline: cloud LLM price per 1M tokens (USD)
CLOUD_LLM_COST_PER_1M_TOKENS_USD=0.50
# Estimated CPU energy cost per kWh (INR)
CPU_ENERGY_COST_PER_KWH_INR=9.0
